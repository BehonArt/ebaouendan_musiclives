+static uint32_t rom32(size_t a) { uint32_t v = 0; if (a + 4 <= g_rom.size()) std::memcpy(&v, &g_rom[a], 4); return v; }
+static uint16_t rom16(size_t a) { uint16_t v = 0; if (a + 2 <= g_rom.size()) std::memcpy(&v, &g_rom[a], 2); return v; }
+
+// A file's id by its path in the cartridge's file system (FNT), or -1.
+static int find_file(const std::string& path) {
+    uint32_t fnt = rom32(0x40);
+    uint16_t dir = 0xF000;                          // the root
+    size_t at = 0;
+    while (at <= path.size()) {
+        size_t slash = path.find('/', at);
+        std::string part = path.substr(at, slash == std::string::npos ? std::string::npos : slash - at);
+        bool last = slash == std::string::npos;
+        size_t e = fnt + rom32(fnt + 8 * (dir & 0xFFF));
+        uint16_t id = rom16(fnt + 8 * (dir & 0xFFF) + 4);
+        bool found = false;
+        for (;;) {
+            uint8_t len = g_rom.size() > e ? g_rom[e] : 0;
+            if (!len) break;
+            bool is_dir = len & 0x80;
+            std::string name((const char*)&g_rom[e + 1], len & 0x7F);
+            e += 1 + (len & 0x7F);
+            if (is_dir) {
+                uint16_t sub = rom16(e);
+                e += 2;
+                if (!last && name == part) { dir = sub; found = true; break; }
+            } else {
+                if (last && name == part) return id;
+                ++id;
+            }
+        }
+        if (!found) return -1;
+        at = slash + 1;
+    }
+    return -1;
+}
+
+static void replace_files() {
+    if (g_cfg.replace_files.empty()) return;
+    size_t original = g_rom.size();
+    uint32_t fat = rom32(0x48), nfat = rom32(0x4C) / 8;
+    for (const auto& [name, path] : g_cfg.replace_files) {
+        int id = find_file(name);
+        if (id < 0 || (uint32_t)id >= nfat) nds_fatal("--replace-file: no %s on the cartridge", name.c_str());
+        FILE* f = std::fopen(path.c_str(), "rb");
+        if (!f) nds_fatal("--replace-file: cannot read %s", path.c_str());
+        std::fseek(f, 0, SEEK_END);
+        long n = std::ftell(f);
+        std::fseek(f, 0, SEEK_SET);
+        size_t at = (g_rom.size() + 0x1FF) & ~(size_t)0x1FF;
+        g_rom.resize(at + (size_t)n, 0xFF);
+        if (std::fread(&g_rom[at], 1, (size_t)n, f) != (size_t)n) nds_fatal("--replace-file: cannot read %s", path.c_str());
+        std::fclose(f);
+        uint32_t ends[2] = {(uint32_t)at, (uint32_t)(at + n)};
+        std::memcpy(&g_rom[fat + 8 * id], ends, 8);
+        nds_note("cartridge: file %d %s from %s (%ld bytes)", id, name.c_str(), path.c_str(), n);
+    }
+    size_t size = original;
+    while (size < g_rom.size()) size *= 2;
+    g_rom.resize(size, 0xFF);
+}
