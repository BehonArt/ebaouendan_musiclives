+//
+// --replace-file NAME=PATH puts another file in place of one of the
+// cartridge's, by its name in the file system (data/seq/SS05_n.seq_): its
+// bytes go after the cartridge's end, the image grows to the next power of
+// two, and its entry in the FAT, which the game reads from the cartridge,
+// points there. The chip ID stays the cartridge's own.
 #include "nds.h"
 #include <cstdio>
 #include <cstring>
@@ -32,6 +38,67 @@ static std::vector<uint8_t> g_save;
 static std::string g_save_path;
