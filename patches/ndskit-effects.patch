+// A port's light (DisplayFx), in GLSL for the compose pass and the 3D's own pass:
+// fx_light(q) at a pixel of the 3D's screen (x 0-256, y 0-192 down), RGB 0-1.
+const char* kFxLightGLSL = R"(
+uniform int u_fx_kind;                            // 0 none, 2 fire
+uniform vec4 u_fx;                                // time (s), level, pulse, flash
+uniform vec4 u_fx2;                               // heat, phase
+float fx_hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
+float fx_noise(vec2 p) {
+    vec2 i = floor(p), f = fract(p);
+    f = f * f * (3.0 - 2.0 * f);
+    return mix(mix(fx_hash(i), fx_hash(i + vec2(1, 0)), f.x), mix(fx_hash(i + vec2(0, 1)), fx_hash(i + vec2(1, 1)), f.x), f.y);
+}
+float fx_fbm(vec2 p) { float v = 0.0, a = 0.5; for (int i = 0; i < 4; ++i) { v += a * fx_noise(p); p *= 2.03; a *= 0.5; } return v; }
+vec3 fx_light(vec2 q) {
+    float t = u_fx.x, level = u_fx.y, pulse = u_fx.z, flash = u_fx.w, heat = u_fx2.x, phase = u_fx2.y;
+    vec3 l = vec3(0.0);
+    if (u_fx_kind == 2) {
+        // fire rising from the bottom, taller with the combo (heat), brighter on hits
+        float h = 40.0 + 130.0 * heat + 25.0 * flash;
+        float y = (192.0 - q.y) / h;
+        float n = fx_fbm(vec2(q.x * 0.045, q.y * 0.03 + t * 2.2)) + 0.35 * fx_fbm(vec2(q.x * 0.11, q.y * 0.08 + t * 3.7));
+        float f = clamp(1.0 - y + (n - 0.55) * 1.4, 0.0, 1.0);
+        f = pow(f, 1.6) * level * (0.6 + 0.4 * pulse + 0.6 * flash);
+        l = mix(vec3(0.9, 0.12, 0.0), vec3(1.0, 0.85, 0.3), clamp(f * 1.3 - 0.2, 0.0, 1.0)) * f;
+    }
+    return l;
+}
+)";
