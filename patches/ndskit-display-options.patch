+    if (d <= 0) d = 1;
+    SDL_Rect u{0, 0, 1280, 720};
+    SDL_GetDisplayUsableBounds(SDL_GetDisplayForWindow(win), &u);
+    double w = 256.0 * s / d, h = 384.0 * s / d;
+    double fit = std::min({1.0, u.w * 0.95 / w, u.h * 0.92 / h});
+    SDL_SetWindowSize(win, (int)(w * fit), (int)(h * fit));
+    SDL_SetWindowPosition(win, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED);
+    nds_note("display: the screens at %dx (%dx%d), the window %dx%d%s", s, 256 * s, 384 * s,
+             (int)(w * fit * d), (int)(h * fit * d), fit < 1.0 ? " (fitted to the display)" : "");
+}
