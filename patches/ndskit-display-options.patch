+// --scale: the composed picture to the window
+const char* kOutFS = R"(#version 450
+layout(binding = 0) uniform sampler2D u_pic;      // the screens at the scale, rows bottom first, linear
+uniform vec4 u_view;                              // the screens' rectangle in the window: x, y (top), w, h
+uniform vec4 u_size;                              // the picture's size in texels (x, y)
+layout(location = 0) out vec4 o_col;
+
+void main() {
+    vec2 win = vec2(gl_FragCoord.x - u_view.x, u_view.w - (gl_FragCoord.y - u_view.y));
+    if (win.x < 0.0 || win.y < 0.0 || win.x >= u_view.z || win.y >= u_view.w) { o_col = vec4(0.0, 0.0, 0.0, 1.0); return; }
+    vec2 size = u_size.xy;
+    vec2 k = u_view.zw / size;                    // window pixels a texel
+    vec2 t = vec2(win.x, u_view.w - win.y) / k;   // the pixel's centre in texels
+    if (k.x >= 1.0) {
+        // sharp bilinear: each texel whole over the integer part of the ratio, blended across its edges
+        vec2 p = max(floor(k), vec2(1.0));
+        vec2 c = fract(t) - 0.5;
+        vec2 r = 0.5 - 0.5 / p;
+        vec2 f = (c - clamp(c, -r, r)) * p + 0.5;
+        o_col = vec4(texture(u_pic, (floor(t) + f) / size).rgb, 1.0);
+    } else {
+        // the mean over the pixel's footprint: n x n bilinear samples spread across it
+        int n = min(int(ceil(1.0 / k.x)), 8);
+        vec2 step = 1.0 / k / float(n);
+        vec2 t0 = t - 0.5 / k + 0.5 * step;
+        vec3 sum = vec3(0.0);
+        for (int j = 0; j < n; ++j)
+            for (int i = 0; i < n; ++i) sum += texture(u_pic, (t0 + vec2(i, j) * step) / size).rgb;
+        o_col = vec4(sum / float(n * n), 1.0);
+    }
+}
+)";
