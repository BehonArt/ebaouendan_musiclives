+// The pace asked for (--fps) on a display refreshing at hz.
+void set_pace(float hz) {
+    refresh_ns = hz > 0 ? 1e9 / hz : kFrameNs;
+    frame_ns = kFrameNs;
+    picture_ns = 0;
+    locked = 0;
+    bool sync = false;
+    int fps = g_cfg.fps;
+    if (fps == 0) {
+        sync = hz >= 50.0f;
+    } else if (fps > 0) {
+        frame_ns = 1e9 / 60;
+        picture_ns = 1e9 / fps;
+        if (hz > 0 && std::fabs(hz - fps) < fps * 0.01f) {
+            sync = true;
+            locked = fps / 60;
+            frame_ns = 1e9 * locked / hz;
+        } else {
+            sync = hz > fps;
+        }
+    }
+    vsync = sync && SDL_GL_SetSwapInterval(1);
