+// The window's settings, changed while it runs (a port's options UI; F9 cycles
+// the layout): each change is made at the start of the next frame.
+enum class NdsLayout { Stacked, SideBySide, Top, Bottom };
+struct DisplaySettings {
+    int scale = 0;                      // the picture: the screens at 256x192 times this (0: from the window)
+    NdsLayout layout = NdsLayout::Stacked;
+    int fps = 0;                        // as --fps: 0 the DS's pace, 60 120 240, -1 uncapped
+    bool fullscreen = false;
+    bool low_latency = false;           // wait for each picture to be drawn before the next (no frames queued)
+};
+const DisplaySettings& display_settings();
+void display_change(const DisplaySettings& s);
+const char* display_layout_name(NdsLayout l);
+
+// A port's own code in the window: the first look at each host event (SDL_Event;
+// true keeps it from the runtime), drawing over the picture before each present
+// (its UI), and space kept free above the screens (a menu bar), in pixels.
+struct DisplayHooks {
+    bool (*event)(const void* sdl_event) = nullptr;
+    void (*draw)(int w, int h) = nullptr;
+};
+void display_set_hooks(const DisplayHooks& h);
+void display_set_top_margin(int pixels);
+struct SDL_Window;
