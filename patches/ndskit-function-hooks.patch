+def hooked(lines, key, hooks):
+    """A function recompiled with a hook (--hook): its body renamed f_X_orig, and
+    in its place f_X, calling the hook a port set with the body, or the body."""
+    if key not in hooks:
+        return lines
+    name = E.fname(key & ~1, key & 1)
+    out = list(lines)
+    i = out.index("void %s(ArmContext& c) {" % name)
+    out[i] = "void %s_orig(ArmContext& c) {" % name
+    return out + ["",
+                  "ArmHookFn %s_hook = nullptr;" % name,
+                  "void %s(ArmContext& c) {" % name,
+                  "    if (%s_hook) %s_hook(c, %s_orig); else %s_orig(c);" % (name, name, name, name),
+                  "}"]
