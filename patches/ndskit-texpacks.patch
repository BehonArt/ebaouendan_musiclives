diff --git a/runtime/texpack.cpp b/runtime/texpack.cpp
new file mode 100644
index 0000000..e726db6
--- /dev/null
+++ b/runtime/texpack.cpp
@@ -0,0 +1,276 @@
+// Texture packs: the 3D's textures replaced by pictures of any resolution, and
+// dumped to make them.
+//
+// A texture is known by a hash of what it shows (texpack_hash): its format,
+// size, colour-0 transparency, texels and the palette entries it uses; not its
+// place in VRAM, so the same picture has the same name in every run. A pack is
+// a folder of <hash>.png files (16 hex digits), RGBA, of the texture's shape at
+// any size, or s<hash>.png for a texture's shape (its texels without the
+// palette: one picture for every palette it is drawn with, a white ring the
+// game tints, say), or t<hash>.png, a shape's picture multiplied by the colour
+// the texture shows most (its palette's: a glow that cycles colours keeps
+// cycling); a polygon using a texture the pack has samples that picture instead
+// (filtered, mipmapped), its colour and alpha combined as the DS's texel's. The
+// first pack listed that has a hash wins. --port tex-dump=DIR writes each
+// texture a run draws, decoded, as DIR/<hash>.png (the way to find one), with
+// DIR/index.txt (hash, format, size, the frame first seen).
+//
+// Options: --port tex-pack=DIR[;DIR...], --port tex-dump=DIR; display.h's
+// display_set_texture_packs() at run time.
+#include "display.h"
+#include "gl.h"
+#include "nds.h"
+#include "render3d.h"
+#include <SDL3/SDL.h>
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <set>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace {
+
+namespace fs = std::filesystem;
+
+std::vector<std::string> g_packs;                       // their folders, first wins
+std::unordered_map<uint64_t, std::string> g_files;      // hash -> its picture (from the packs)
+std::unordered_map<uint64_t, std::string> g_shapes;     // shape hash -> its picture (s<hash>.png)
+std::unordered_map<uint64_t, std::string> g_tinted;     // shape hash -> its picture, to tint (t<hash>.png)
+std::unordered_map<uint64_t, uint32_t> g_tint;          // a texture's hash -> the colour it shows most (RGB8)
+std::unordered_map<uint64_t, GLuint> g_loaded;          // hash -> its texture (0: could not load)
+bool g_packs_read;
+std::string g_dump;
+std::set<uint64_t> g_dumped;
+std::set<uint64_t> g_hidden;                            // display_set_texture_hidden
+std::FILE* g_index;
+
+uint32_t c6(uint32_t c5) { return c5 == 0 ? 0 : c5 * 2 + 1; }
+uint8_t c8(uint32_t c6v) { return (uint8_t)(c6v << 2 | c6v >> 4); }
+
+struct Tex {
+    const uint8_t* vram;                                // 512 KiB
+    const uint8_t* pal;                                 // 96 KiB
+    uint32_t p, pb;
+    int w, h, fmt;
+    uint32_t addr, pbase;                               // bytes; halfwords
+    uint8_t rd8(uint32_t a) const { return vram[a & 0x7FFFF]; }
+    uint16_t rd16(uint32_t a) const { return (uint16_t)(rd8(a) | rd8(a + 1) << 8); }
+    uint32_t rd32(uint32_t a) const { return rd16(a) | (uint32_t)rd16(a + 2) << 16; }
+    uint16_t palw(uint32_t i) const { i %= 0xC000; return (uint16_t)(pal[i * 2] | pal[i * 2 + 1] << 8); }
+    Tex(const Render3dJob& J, uint32_t tp, uint32_t pbv) : vram(J.tex.data()), pal(J.texpal.data()), p(tp), pb(pbv) {
+        w = 8 << (p >> 20 & 7);
+        h = 8 << (p >> 23 & 7);
+        fmt = p >> 26 & 7;
+        addr = (p & 0xFFFF) << 3;
+        pbase = fmt == 2 ? pb << 2 : pb << 3;
+    }
+    // the texel, as the 3D's shader decodes it: rgb 0-63, alpha 0-31
+    void texel(int s, int t, uint32_t out[4]) const {
+        uint32_t i = (uint32_t)(t * w + s);
+        bool tr0 = p & 0x20000000;
+        auto put = [&](uint16_t c, uint32_t a) { out[0] = c6(c & 31); out[1] = c6(c >> 5 & 31); out[2] = c6(c >> 10 & 31); out[3] = a; };
+        switch (fmt) {
+        case 1: { uint8_t b = rd8(addr + i); uint32_t a = b >> 5; put(palw(pbase + (b & 31)), a * 4 + (a >> 1)); return; }
+        case 2: { uint32_t x = rd8(addr + i / 4) >> (2 * (i & 3)) & 3; if (tr0 && !x) put(0, 0); else put(palw(pbase + x), 31); return; }
+        case 3: { uint32_t x = rd8(addr + i / 2) >> (4 * (i & 1)) & 15; if (tr0 && !x) put(0, 0); else put(palw(pbase + x), 31); return; }
+        case 4: { uint32_t x = rd8(addr + i); if (tr0 && !x) put(0, 0); else put(palw(pbase + x), 31); return; }
+        case 5: {
+            uint32_t blk = addr + (uint32_t)((t >> 2) * (w >> 2) + (s >> 2)) * 4;
+            uint32_t x = rd32(blk) >> ((t & 3) * 8 + (s & 3) * 2) & 3;
+            uint32_t slot = blk >> 17;
+            uint32_t ia = 0x20000 + ((blk & 0x1FFFF) >> 1) + (slot == 2 ? 0x10000 : 0);
+            uint16_t pw = rd16(ia);
+            uint32_t base = pbase + (pw & 0x3FFF) * 2, mode = pw >> 14;
+            uint16_t ca = palw(base), cb = palw(base + 1);
+            if (x == 0) { put(ca, 31); return; }
+            if (x == 1) { put(cb, 31); return; }
+            if (mode == 0) { if (x == 2) put(palw(base + 2), 31); else put(0, 0); return; }
+            if (mode == 2) { put(palw(base + x), 31); return; }
+            uint32_t ra[3] = {c6(ca & 31), c6(ca >> 5 & 31), c6(ca >> 10 & 31)}, rb[3] = {c6(cb & 31), c6(cb >> 5 & 31), c6(cb >> 10 & 31)};
+            if (mode == 1 && x == 3) { out[0] = out[1] = out[2] = out[3] = 0; return; }
+            for (int k = 0; k < 3; ++k)
+                out[k] = mode == 1 ? (ra[k] + rb[k]) / 2 : x == 2 ? (ra[k] * 5 + rb[k] * 3) / 8 : (ra[k] * 3 + rb[k] * 5) / 8;
+            out[3] = 31;
+            return;
+        }
+        case 6: { uint8_t b = rd8(addr + i); put(palw(pbase + (b & 7)), b >> 3); return; }
+        default: { uint16_t c = rd16(addr + i * 2); put(c, (c & 0x8000) ? 31 : 0); return; }
+        }
+    }
+};
+
+uint64_t fnv(uint64_t h, const void* d, size_t n) {
+    auto p = static_cast<const uint8_t*>(d);
+    for (size_t i = 0; i < n; ++i) h = (h ^ p[i]) * 0x100000001B3ull;
+    return h;
+}
+
+void options() {                                        // --port tex-pack, tex-dump: once
+    static bool done;
+    if (done) return;
+    done = true;
+    if (g_cfg.port.count("tex-pack")) {
+        std::string s = g_cfg.port.at("tex-pack");
+        for (size_t a = 0; a <= s.size();) {
+            size_t b = s.find(';', a);
+            if (b == std::string::npos) b = s.size();
+            if (b > a) g_packs.push_back(s.substr(a, b - a));
+            a = b + 1;
+        }
+    }
+    if (g_cfg.port.count("tex-dump")) g_dump = g_cfg.port.at("tex-dump");
+}
+
+void read_packs() {
+    g_packs_read = true;
+    g_files.clear();
+    g_shapes.clear();
+    g_tinted.clear();
+    for (auto it = g_packs.rbegin(); it != g_packs.rend(); ++it) {   // the first listed, read last, wins
+        std::error_code ec;
+        for (const auto& e : fs::directory_iterator(*it, ec)) {
+            std::string n = e.path().filename().string();
+            bool shape = n.size() == 21 && (n[0] == 's' || n[0] == 't');
+            if ((n.size() != 20 && !shape) || n.substr(n.size() - 4) != ".png") continue;
+            char* end = nullptr;
+            uint64_t h = std::strtoull(n.substr(shape ? 1 : 0, 16).c_str(), &end, 16);
+            if (end && *end == '\0') (!shape ? g_files : n[0] == 's' ? g_shapes : g_tinted)[h] = e.path().string();
+        }
+    }
+    if (!g_packs.empty())
+        nds_note("3D: texture packs: %zu pictures, %zu shapes, in %zu folder(s)", g_files.size(), g_shapes.size(), g_packs.size());
+}
+
+}  // namespace
+
+uint64_t texpack_hash(const Render3dJob& J, uint32_t tp, uint32_t pb, bool with_palette) {
+    Tex t(J, tp, pb);
+    uint64_t h = 0xCBF29CE484222325ull;
+    uint32_t head[4] = {(uint32_t)t.fmt, (uint32_t)t.w, (uint32_t)t.h, (tp >> 29) & 1};
+    h = fnv(h, head, sizeof head);
+    static const int bpp[8] = {0, 8, 2, 4, 8, 2, 8, 16};
+    uint32_t bytes = (uint32_t)(t.w * t.h * bpp[t.fmt] / 8);
+    for (uint32_t i = 0; i < bytes; ++i) { uint8_t b = t.rd8(t.addr + i); h = (h ^ b) * 0x100000001B3ull; }
+    static const int colours[8] = {0, 32, 4, 16, 256, 0, 8, 0};
+    uint32_t n = (uint32_t)colours[t.fmt];
+    if (t.fmt == 5) {                                    // the blocks' palette words, and the entries they reach
+        uint32_t blocks = (uint32_t)(t.w * t.h / 16), top = 0;
+        for (uint32_t b = 0; b < blocks; ++b) {
+            uint32_t blk = t.addr + b * 4, slot = blk >> 17;
+            uint16_t pw = t.rd16(0x20000 + ((blk & 0x1FFFF) >> 1) + (slot == 2 ? 0x10000 : 0));
+            h = fnv(h, &pw, 2);
+            top = std::max(top, (uint32_t)(pw & 0x3FFF) * 2 + 4);
+        }
+        n = std::min(top, 1024u);
+    }
+    if (with_palette)
+        for (uint32_t i = 0; i < n; ++i) { uint16_t c = t.palw(t.pbase + i); h = fnv(h, &c, 2); }
+    return h;
+}
+
+// The replacement's texture for a hash (0: none), and the dump of a texture new to this run.
+GLuint texpack_lookup(const Render3dJob& J, uint32_t tp, uint32_t pb, uint64_t h, uint32_t* tint) {
+    if (tint) *tint = 0xFFFFFF;
+    options();
+    if (!g_packs_read) read_packs();
+    if (!g_dump.empty() && g_dumped.insert(h).second) {
+        Tex t(J, tp, pb);
+        std::vector<uint8_t> px((size_t)t.w * t.h * 4);
+        uint32_t c[4];
+        for (int y = 0; y < t.h; ++y)
+            for (int x = 0; x < t.w; ++x) {
+                t.texel(x, y, c);
+                uint8_t* o = &px[((size_t)y * t.w + x) * 4];
+                o[0] = c8(c[0]); o[1] = c8(c[1]); o[2] = c8(c[2]); o[3] = (uint8_t)(c[3] * 255 / 31);
+            }
+        std::error_code ec;
+        fs::create_directories(g_dump, ec);
+        char name[32];
+        std::snprintf(name, sizeof name, "%016llx.png", (unsigned long long)h);
+        if (SDL_Surface* s = SDL_CreateSurfaceFrom(t.w, t.h, SDL_PIXELFORMAT_ABGR8888, px.data(), t.w * 4)) {
+            SDL_SavePNG(s, (fs::path(g_dump) / name).string().c_str());
+            SDL_DestroySurface(s);
+        }
+        if (!g_index) g_index = std::fopen((fs::path(g_dump) / "index.txt").string().c_str(), "a");
+        if (g_index) {
+            std::fprintf(g_index, "%016llx fmt %d %dx%d frame %llu tr0 %d shape s%016llx\n", (unsigned long long)h, t.fmt,
+                         t.w, t.h, (unsigned long long)J.frame, (int)(tp >> 29 & 1),
+                         (unsigned long long)texpack_hash(J, tp, pb, false));
+            std::fflush(g_index);
+        }
+    }
+    if (!g_hidden.empty() && g_hidden.count(h)) return kTexHidden;
+    auto f = g_files.find(h);
+    uint64_t key = h;
+    if (f == g_files.end()) {                           // its shape, any palette
+        if (g_shapes.empty() && g_tinted.empty()) return 0;
+        uint64_t shape = texpack_hash(J, tp, pb, false);
+        auto fs = g_shapes.find(shape);
+        if (fs != g_shapes.end()) {
+            f = fs;
+            key = shape ^ 0x5348415045ull;
+        } else {
+            auto ft = g_tinted.find(shape);
+            if (ft == g_tinted.end()) return 0;
+            f = ft;
+            key = shape ^ 0x54494E54ull;                // to tint: by the colour it shows most
+            auto c = g_tint.find(h);
+            if (c == g_tint.end()) {
+                Tex t(J, tp, pb);
+                std::unordered_map<uint32_t, int> n;
+                uint32_t px[4];
+                for (int y = 0; y < t.h; ++y)
+                    for (int x = 0; x < t.w; ++x) {
+                        t.texel(x, y, px);
+                        if (px[3]) ++n[c8(px[0]) | c8(px[1]) << 8 | c8(px[2]) << 16];
+                    }
+                uint32_t best = 0xFFFFFF;
+                int most = 0;
+                for (auto& [col, k] : n)
+                    if (k > most) { most = k; best = col; }
+                c = g_tint.emplace(h, best).first;
+            }
+            if (tint) *tint = c->second;
+        }
+    }
+    auto l = g_loaded.find(key);
+    if (l != g_loaded.end()) return l->second;
+    GLuint id = 0;
+    SDL_Surface* s = SDL_LoadPNG(f->second.c_str());
+    SDL_Surface* rgba = s ? SDL_ConvertSurface(s, SDL_PIXELFORMAT_ABGR8888) : nullptr;
+    if (rgba) {
+        int levels = 1;
+        for (int m = std::max(rgba->w, rgba->h); m > 1; m >>= 1) ++levels;
+        glCreateTextures(GL_TEXTURE_2D, 1, &id);
+        glTextureStorage2D(id, levels, GL_RGBA8, rgba->w, rgba->h);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+        glTextureSubImage2D(id, 0, 0, 0, rgba->w, rgba->h, GL_RGBA, GL_UNSIGNED_BYTE, rgba->pixels);
+        glGenerateTextureMipmap(id);
+        glTextureParameteri(id, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+        glTextureParameteri(id, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    } else {
+        nds_note("3D: texture pack: cannot load %s", f->second.c_str());
+    }
+    if (rgba) SDL_DestroySurface(rgba);
+    if (s) SDL_DestroySurface(s);
+    return g_loaded[key] = id;
+}
+
+bool texpack_active() {
+    options();
+    return !g_packs.empty() || !g_dump.empty() || !g_hidden.empty();
+}
+
+void display_set_texture_hidden(const std::vector<uint64_t>& hashes) { g_hidden = std::set<uint64_t>(hashes.begin(), hashes.end()); }
+
+void display_set_texture_packs(const std::vector<std::string>& dirs) {
+    options();
+    g_packs = dirs;
+    for (auto& [h, id] : g_loaded)
+        if (id) glDeleteTextures(1, &id);
+    g_loaded.clear();
+    read_packs();
+}
